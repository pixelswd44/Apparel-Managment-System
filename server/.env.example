# ── Server config ──────────────────────────────────────────────────────────
PORT=3001
JWT_SECRET=replace-with-a-long-random-string

# ── App URL (used in password reset links) ──────────────────────────────────
# In dev: http://localhost:5173
# In prod: https://your-domain.com
APP_URL=http://localhost:5173

# ── Backups ─────────────────────────────────────────────────────────────────
# Automatic daily snapshot (data + uploaded images) into data/backups/.
# Also refreshes data/latest-backup.json.gz. Newest BACKUP_KEEP are retained.
BACKUP_AUTO_DAILY=1
BACKUP_KEEP=20

# ── Web Push (task reminders while the app is closed) ───────────────────────
# Generate a key pair once (keep the same keys afterwards — changing them makes
# every device turn notifications on again):
#   cd server && npx web-push generate-vapid-keys
# VAPID_SUBJECT is a contact for the push services: mailto: address or https URL.
# Leave the keys blank to keep push off (reminders then only show in an open tab).
# Push needs the site on HTTPS (or localhost). On iPhone/iPad it only works after
# "Add to Home Screen" (iOS 16.4+), then turning notifications on from the bell.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Email / SMTP (for password reset) ───────────────────────────────────────
# Leave these blank to fall back to on-screen reset links (no email).
#
# Gmail setup (FREE — recommended):
#   1. Enable 2-Step Verification at https://myaccount.google.com/security
#   2. Generate an "App Password" at https://myaccount.google.com/apppasswords
#      (pick "Mail" + "Other" → name it "Apparel CRM")
#   3. Use the 16-character app password below (NOT your real Gmail password)
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Apparel CRM" <your-email@gmail.com>

# ── Other SMTP providers ────────────────────────────────────────────────────
# Outlook / Office 365:    smtp.office365.com  port 587
# Yahoo:                   smtp.mail.yahoo.com port 587
# Brevo (free 300/day):    smtp-relay.brevo.com port 587
# Your own domain:         smtp.your-domain.com (ask your hosting provider)
